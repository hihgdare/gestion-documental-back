@baseUrl = http://localhost:3000/api
@module = contracts
@token = skip-token

###

# @name create
POST {{baseUrl}}/{{module}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "startDate": "2025-11-20",
  "endDate": "2025-12-10",
  "nombreColaborador": "Willem",
  "contractNumber": "24681012",
  "administradorContratoMandante": "Yo",
  "administradorContratoEmpresa": "Yo",
  "nombreMandante": "Cualquiera",
  "division": "Mi casa",
  "area": "Mi cuarto",
  "descripcionServicio": "contrato de prueba 1",
  "nombreProyecto": "MiProyecto",
  "rutSociedad": "12.345.678-5",
  "contractType": "obra_faena",
  "rutAdministradorContrato": "23.456.789-6",
  "jornadaTrabajo": "turno"
}

###

@id = {{ create.response.body.data.id }}

###

GET {{baseUrl}}/{{module}}/{{id}}
Authorization: Bearer {{token}}

###

PUT {{baseUrl}}/{{module}}/{{id}}
Content-Type: application/json
Authorization: Bearer {{token}}

