@baseUrl = http://localhost:3000/api
@module = contracts
@token = skip-token

###

# @name get-all
GET {{baseUrl}}/{{module}}
Authorization: Bearer {{token}}

###

# @name create
POST {{baseUrl}}/{{module}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "startDate": "2025-11-25",
  "endDate": "2025-12-10",
  "nombreColaborador": "Willem",
  "contractNumber": "12345678",
  "administradorContratoMandante": "Yo",
  "administradorContratoEmpresa": "Yo",
  "nombreMandante": "Cualquiera",
  "division": "Mi casa",
  "area": "Mi cuarto",
  "descripcionServicio": "contrato de prueba 1",
  "nombreProyecto": "MiProyecto",
  "rutSociedad": "12.345.678-5",
  "contractType": "obra_faena",
  "rutAdministradorContrato": "23.456.789-6",
  "jornadaTrabajo": "turno"
}

###

@id = {{ create.response.body.data.id }}

###

# @name get
GET {{baseUrl}}/{{module}}/{{id}}
Authorization: Bearer {{token}}

###

# @name update
PUT {{baseUrl}}/{{module}}/{{id}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombreColaborador": "WillemF",
  "descripcionServicio": "contrato de prueba 2",
  "dotacionPersonal": 1,
  "dotacionVehiculos": 1,
  "endDate": "2025-12-15"
}

###

# ============================================
# SUBCONTRACT MANAGEMENT
# ============================================

# @name create-subcontract
# Create a second contract to use as subcontract
POST {{baseUrl}}/{{module}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "startDate": "2025-11-25",
  "endDate": "2025-12-10",
  "nombreColaborador": "Subcontractor",
  "contractNumber": "SUB-001",
  "administradorContratoMandante": "Admin Sub",
  "administradorContratoEmpresa": "Admin Sub Empresa",
  "nombreMandante": "Mandante Sub",
  "division": "Division Sub",
  "area": "Area Sub",
  "descripcionServicio": "Subcontrato de prueba",
  "nombreProyecto": "Proyecto Sub",
  "rutSociedad": "98.765.432-1",
  "contractType": "consultoria",
  "rutAdministradorContrato": "11.222.333-4",
  "jornadaTrabajo": "completa"
}

###

@subcontractId = {{ create-subcontract.response.body.data.id }}

###

# @name add-subcontract
# Add subcontract relationship
POST {{baseUrl}}/{{module}}/{{id}}/subcontracts
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "subcontractId": "{{subcontractId}}"
}

###

# @name get-subcontracts
# Get all subcontracts of a contract
GET {{baseUrl}}/{{module}}/{{id}}/subcontracts
Authorization: Bearer {{token}}

###

# @name remove-subcontract
# Remove subcontract relationship
DELETE {{baseUrl}}/{{module}}/{{id}}/subcontracts/{{subcontractId}}
Authorization: Bearer {{token}}

###

# @name add-self-as-subcontract
# Test validation: Try to add contract to itself (should fail with 400)
POST {{baseUrl}}/{{module}}/{{id}}/subcontracts
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "subcontractId": "{{id}}"
}

###

# @name add-subcontract-missing-id
# Test validation: Try to add subcontract without ID (should fail with 400)
POST {{baseUrl}}/{{module}}/{{id}}/subcontracts
Content-Type: application/json
Authorization: Bearer {{token}}

{
}

