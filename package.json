{
  "name": "gestion-documental-back",
  "version": "1.0.0",
  "description": "Backend API for Document Management System using DDD + Clean Architecture",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun run tsc",
    "start": "bun run dist/index.js",
    "dev": "bun run --hot src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "bun run eslint src/**/*.ts",
    "lint:fix": "bun run eslint src/**/*.ts --fix",
    "migration:create": "typeorm migration:create -d data-source.js",
    "migration:generate": "typeorm migration:generate -d data-source.js",
    "migration:run": "typeorm migration:run -d data-source.js",
    "migration:revert": "typeorm migration:revert -d data-source.js",
    "migration:show": "typeorm migration:show -d data-source.js",
    "install:bun": "bun install",
    "clean": "rm -rf node_modules bun.lockb dist"
  },
  "keywords": [
    "nodejs",
    "express",
    "typescript",
    "ddd",
    "clean-architecture",
    "sqlserver",
    "api"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "express-rate-limit": "^7.1.5",
    "compression": "^1.7.4",
    "typeorm": "^0.3.17",
    "mysql2": "^3.6.5",
    "reflect-metadata": "^0.1.13",
    "class-validator": "^0.14.0",
    "class-transformer": "^0.5.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "joi": "^17.11.0",
    "axios": "^1.6.2",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "express-async-errors": "^3.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "1.2.23",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.4",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.7",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.38.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "trustedDependencies": [
    "@types/node",
    "typescript"
  ]
}
